# Copy this file to .env.staging on the server. Never commit the real file.
POSTGRES_PASSWORD=CHANGE_TO_A_LONG_RANDOM_PASSWORD

# Staging identity
PUBLIC_APP_URL=http://192.168.1.113:8781
OWNER_EMAIL=
DEV_BYPASS=false

# Keep production integrations disabled during the first test.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LIFF_ID=
LIFF_TECHNICIAN_ID=

# Optional database aliases used by some modules.
USER_DB_URL=
TECH_DB_URL=
ADMIN_DB_URL=
